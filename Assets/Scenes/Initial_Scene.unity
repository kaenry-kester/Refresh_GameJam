    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 4
    m_MaxSize: 300
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.3
  m_Text: "     Como professor de biologia, n\xE3o consigo aceitar que esse seja
    o destino do nosso planeta. Por isso, decidi dedicar minhas pesquisas a uma possibilidade
    que, at\xE9 pouco tempo atr\xE1s, parecia imposs\xEDvel: trazer de volta esp\xE9cies
    vegetais que perdemos."
